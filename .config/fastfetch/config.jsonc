{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": "~/.config/fastfetch/anis-chan.sixel",
        "width": 22,
        "height": 12,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ❯ ",
        "color": {
            "title": "magenta"
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "─────────────────────────"
        },
        {
            "type": "os",
            "key": "  os",
            "keyColor": "blue",
            "format": "android 10"
        },
        {
            "type": "kernel",
            "key": " 󰌽 ker",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": " 󱎫 up",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": " 󰏖 pkg",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " 󰞷 sh",
            "keyColor": "magenta"
        },
        {
            "type": "de",
            "key": " 󰧨 de",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " 󰞍 term",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": " 󰁹 bat",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " 󰍛 cpu",
            "keyColor": "yellow",
            "showPeCoreCount": false
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
