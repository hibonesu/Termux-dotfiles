set shell bash

# set color256
set icons
set hidden
set incsearch
set scrolloff 4
set tabstop 2
set smartcase
set dircounts
set info size
set sortby natural
set ratios '3:2'
set timefmt '2006-01-02 15:04:05 -0700'
set previewer ~/.config/lf/preview
set cleaner ~/.config/lf/cleaner
set period 0
#set sixel true

# open machanisms
map <enter> open
map E &$OPENER $f
map o $mimeopen --ask $f
map O $mimeopen --ask-default $f

# create directory/file
map t push $touch<space>

# --- Quick Edit ---
map e $$EDITOR "$f"

